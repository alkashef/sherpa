+++ b/tests/unit/test_money.py
@@ -0,0 +1,49 @@
+import re
+from decimal import Decimal
+
+import pytest
+from hypothesis import given, settings
+from hypothesis import strategies as st
+
+from src.money import format_amount, parse_amount
+
+
+def _assert_invalid_amount(text: str) -> None:
+    message = "the amount must be a number from 0.01 to 1000000.00 with at most two decimals"
+    with pytest.raises(ValueError, match=rf"^{re.escape(message)}\Z"):
+        parse_amount(text)
+
+
+def test_ledg_002_ex_002_three_decimals_are_refused() -> None:
+    _assert_invalid_amount("12.345")
+
+
+def test_ledg_002_ex_003_zero_is_refused() -> None:
+    _assert_invalid_amount("0")
+
+
+def test_ledg_002_ex_004_upper_limit() -> None:
+    assert parse_amount("999999.99") == 99_999_999
+    assert parse_amount("1000000.00") == 100_000_000
+    _assert_invalid_amount("1000000.01")
+
+
+@pytest.mark.parametrize(("text", "cents"), [("0.01", 1), ("0.02", 2), ("3", 300), ("4.1", 410)])
+def test_ledg_002_valid_amount_in_cents(text: str, cents: int) -> None:
+    assert parse_amount(text) == cents
+
+
+@pytest.mark.parametrize("text", ["", "five", "-0.01", "NaN", "Infinity"])
+def test_ledg_002_invalid_amount_is_refused(text: str) -> None:
+    _assert_invalid_amount(text)
+
+
+@given(amount=st.decimals(min_value=Decimal("0.01"), max_value=Decimal("1000000.00"), places=2))
+@settings(max_examples=50, derandomize=True)
+def test_ledg_002_valid_decimal_amount_preserves_every_cent(amount: Decimal) -> None:
+    assert parse_amount(str(amount)) == amount * 100
+
+
+@pytest.mark.parametrize(("cents", "expected"), [(0, "0.00"), (1, "0.01"), (1250, "12.50")])
+def test_ledg_004_format_amount_has_two_decimals(cents: int, expected: str) -> None:
+    assert format_amount(cents) == expected
diff --git a/tests/unit/test_store.py b/tests/unit/test_store.py
new file mode 100644
index 0000000000000000000000000000000000000000..42cc6ac824c0109fe56b60de57fe9e5d5e0c1981
--- /dev/null
+++ b/tests/unit/test_store.py
@@ -0,0 +1,83 @@
+import json
+from pathlib import Path
+
+import pytest
+
+from src.store import Entry, load, save
+
+
+def _entry_fields() -> dict[str, object]:
+    return {
+        "id": "76543210-abcd-4321-8abc-0123456789ab",
+        "amount_cents": 410,
+        "category": "bus",
+        "note": "",
+        "created": "2026-11-23T10:00:00Z",
+    }
+
+
+def _assert_invalid_file(path: Path, content: str) -> None:
+    path.write_text(content, encoding="utf-8")
+    with pytest.raises(ValueError, match=r"^the data file is not a valid ledger\Z"):
+        load(path)
+
+
+def test_ledg_006_missing_file_is_an_empty_ledger(tmp_path: Path) -> None:
+    assert load(tmp_path / "new" / "ledger.json") == []
+
+
+def test_ledg_006_save_writes_the_entry_fields(tmp_path: Path) -> None:
+    entry = Entry("76543210-abcd-4321-8abc-0123456789ab", 410, "bus", "", "2026-11-23T10:00:00Z")
+    path = tmp_path / "new" / "ledger.json"
+    save(path, [entry])
+    assert json.loads(path.read_text(encoding="utf-8")) == {"entries": [_entry_fields()]}
+    assert load(path) == [entry]
+
+
+def test_ledg_006_replacing_the_ledger_preserves_the_previous_file(tmp_path: Path) -> None:
+    path = tmp_path / "ledger.json"
+    previous_content = json.dumps({"entries": [_entry_fields()]})
+    path.write_text(previous_content, encoding="utf-8")
+    previous_file = tmp_path / "previous.json"
+    previous_file.hardlink_to(path)
+    save(path, [])
+    assert json.loads(path.read_text(encoding="utf-8")) == {"entries": []}
+    assert previous_file.read_text(encoding="utf-8") == previous_content
+
+
+@pytest.mark.parametrize(
+    "content",
+    ["not json", "null", "[]", "{}", '{"entries": {}}', '{"entries": [], "extra": 1}'],
+)
+def test_ledg_007_invalid_file_raises_value_error(tmp_path: Path, content: str) -> None:
+    _assert_invalid_file(tmp_path / "ledger.json", content)
+
+
+@pytest.mark.parametrize(
+    ("key", "value"),
+    [
+        ("id", "not-a-uuid"),
+        ("id", "76543210-abcd-1321-8abc-0123456789ab"),
+        ("amount_cents", 0),
+        ("amount_cents", 100_000_001),
+        ("amount_cents", 4.5),
+        ("amount_cents", True),
+        ("category", "Bus"),
+        ("note", None),
+        ("created", "yesterday"),
+        ("created", "2026-11-23T10:00:00"),
+        ("extra", "unexpected"),
+    ],
+)
+def test_ledg_007_invalid_entry_is_refused(tmp_path: Path, key: str, value: object) -> None:
+    entry = _entry_fields()
+    entry[key] = value
+    content = json.dumps({"entries": [entry]})
+    _assert_invalid_file(tmp_path / "ledger.json", content)
+
+
+@pytest.mark.parametrize("missing", ["id", "amount_cents", "category", "note", "created"])
+def test_ledg_007_incomplete_entry_is_refused(tmp_path: Path, missing: str) -> None:
+    entry = _entry_fields()
+    del entry[missing]
+    _assert_invalid_file(tmp_path / "ledger.json", json.dumps({"entries": [entry]}))

