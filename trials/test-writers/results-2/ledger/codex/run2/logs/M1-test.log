+
+
+def _assert_amount_error(result: subprocess.CompletedProcess[str]) -> None:
+    assert result.stderr == (
+        "error: the amount must be a number from 0.01 to 1000000.00 with at most two decimals\n"
+    )
+    assert result.returncode == 2
+    assert result.stdout == ""
+
+
+def _assert_category_error(result: subprocess.CompletedProcess[str]) -> None:
+    assert result.stderr == "error: the category must be 1 to 20 lowercase letters\n"
+    assert result.returncode == 2
+    assert result.stdout == ""
+
+
+def test_ledg_001_ex_001_add_prints_the_id_and_stores_the_entry(tmp_path: Path) -> None:
+    entry_id = _entry_id(_run(tmp_path, "add", "12.50", "food", "--note", "lunch"))
+    assert _output(_run(tmp_path, "list")) == f"{entry_id}\t12.50\tfood\tlunch\n"
+    data = json.loads((tmp_path / "ledger.json").read_text(encoding="utf-8"))
+    [entry] = data["entries"]
+    created = entry["created"]
+    assert datetime.fromisoformat(created).utcoffset() == timedelta(0)
+    assert entry == {
+        "id": entry_id,
+        "amount_cents": 1250,
+        "category": "food",
+        "note": "lunch",
+        "created": created,
+    }
+
+
+def test_ledg_001_ex_004_largest_amount_is_stored(tmp_path: Path) -> None:
+    entry_id = _entry_id(_run(tmp_path, "add", "1000000.00", "food"))
+    expected = f"{entry_id}\t1000000.00\tfood\t\n"
+    assert _output(_run(tmp_path, "list")) == expected
+    _assert_amount_error(_run(tmp_path, "add", "1000000.01", "food"))
+    assert _output(_run(tmp_path, "list")) == expected
+
+
+def test_ledg_002_ex_002_cli_refuses_three_decimals(tmp_path: Path) -> None:
+    entry_id = _entry_id(_run(tmp_path, "add", "3", "bus"))
+    _assert_amount_error(_run(tmp_path, "add", "12.345", "food"))
+    assert _output(_run(tmp_path, "list")) == f"{entry_id}\t3.00\tbus\t\n"
+
+
+def test_ledg_002_ex_003_cli_refuses_zero(tmp_path: Path) -> None:
+    _assert_amount_error(_run(tmp_path, "add", "0", "food"))
+    assert _output(_run(tmp_path, "list")) == ""
+
+
+def test_ledg_003_ex_005_uppercase_category_is_refused(tmp_path: Path) -> None:
+    _assert_category_error(_run(tmp_path, "add", "5", "Food"))
+    assert _output(_run(tmp_path, "list")) == ""
+
+
+@pytest.mark.parametrize("category", ["a", "ab", "a" * 19, "a" * 20])
+def test_ledg_003_valid_category_lengths(tmp_path: Path, category: str) -> None:
+    entry_id = _entry_id(_run(tmp_path, "add", "1", category))
+    assert _output(_run(tmp_path, "list")) == f"{entry_id}\t1.00\t{category}\t\n"
+
+
+@pytest.mark.parametrize("category", ["", "a" * 21, "bus2", "two words", "café", "a_b", "a\n"])
+def test_ledg_003_invalid_categories(tmp_path: Path, category: str) -> None:
+    _assert_category_error(_run(tmp_path, "add", "1", category))
+    assert _output(_run(tmp_path, "list")) == ""
+
+
+@settings(max_examples=50, derandomize=True, deadline=None)
+@given(category=st.text(alphabet="abcdefghijklmnopqrstuvwxyzAB39-_ é", max_size=22))
+def test_ledg_003_only_valid_categories_are_stored(category: str) -> None:
+    with TemporaryDirectory() as directory:
+        folder = Path(directory)
+        added = _run(folder, "add", "1", category)
+        if 1 <= len(category) <= 20 and all("a" <= letter <= "z" for letter in category):
+            entry_id = _entry_id(added)
+            assert _output(_run(folder, "list")) == f"{entry_id}\t1.00\t{category}\t\n"
+        else:
+            _assert_category_error(added)
+            assert _output(_run(folder, "list")) == ""
+
+
+def test_ledg_004_ex_006_total_and_total_of_a_category(tmp_path: Path) -> None:
+    for amount, category in [("12.50", "food"), ("7.25", "food"), ("3", "bus")]:
+        _entry_id(_run(tmp_path, "add", amount, category))
+    assert _output(_run(tmp_path, "total")) == "22.75\n"
+    assert _output(_run(tmp_path, "total", "--category", "food")) == "19.75\n"
+    assert _output(_run(tmp_path, "total", "--category", "books")) == "0.00\n"
+    assert _output(_run(tmp_path, "total")) == "22.75\n"
+
+
+def test_ledg_004_ex_007_empty_total(tmp_path: Path) -> None:
+    assert _output(_run(tmp_path, "total")) == "0.00\n"
+
+
+def test_ledg_005_ex_008_list_in_order_of_entry(tmp_path: Path) -> None:
+    first = _entry_id(_run(tmp_path, "add", "4.10", "bus"))
+    second = _entry_id(_run(tmp_path, "add", "2", "food", "--note", "bread"))
+    assert first != second
+    assert _output(_run(tmp_path, "list")) == f"{first}\t4.10\tbus\t\n{second}\t2.00\tfood\tbread\n"
+    data = json.loads((tmp_path / "ledger.json").read_text(encoding="utf-8"))
+    assert data["entries"][0]["note"] == ""
+
+
+def test_ledg_006_ex_009_add_makes_the_folder(tmp_path: Path) -> None:
+    path = "new/ledger.json"
+    _entry_id(_run(tmp_path, "add", "1", "food", data_file=path))
+    assert (tmp_path / path).is_file()
+    assert _output(_run(tmp_path, "total", data_file=path)) == "1.00\n"
+
+
+def test_ledg_006_default_data_file_is_relative_to_working_folder(tmp_path: Path) -> None:
+    entry_id = _entry_id(_run(tmp_path, "add", "2", "food", data_file=None))
+    path = tmp_path / "data" / "ledger.json"
+    data = json.loads(path.read_text(encoding="utf-8"))
+    assert [entry["id"] for entry in data["entries"]] == [entry_id]
+
+
+@pytest.mark.parametrize("args", [("total",), ("list",), ("add", "1", "food")])
+def test_ledg_007_ex_010_invalid_data_file_exits_3(tmp_path: Path, args: tuple[str, ...]) -> None:
+    path = tmp_path / "ledger.json"
+    path.write_bytes(b"not json")
+    result = _run(tmp_path, *args)
+    assert result.stderr == "error: the data file is not a valid ledger\n"
+    assert result.returncode == 3
+    assert result.stdout == ""
+    assert path.read_bytes() == b"not json"
diff --git a/tests/unit/test_money.py b/tests/unit/test_money.py
new file mode 100644
index 0000000000000000000000000000000000000000..6a750a39a49425d8ea88671b9c05704cb627e90e
--- /dev/null
+++ b/tests/unit/test_money.py
@@ -0,0 +1,56 @@
+from importlib import import_module
+
+import pytest
+from hypothesis import given, settings
+from hypothesis import strategies as st
+
+money = import_module("src.money")
+
+
+def _assert_invalid_amount(text: str) -> None:
+    with pytest.raises(
+        ValueError,
+        match=r"^the amount must be a number from 0\.01 to "
+        r"1000000\.00 with at most two decimals\Z",
+    ):
+        money.parse_amount(text)
+
+
+def test_ledg_002_ex_002_three_decimals_are_refused() -> None:
+    _assert_invalid_amount("12.345")
+
+
+def test_ledg_002_ex_003_zero_is_refused() -> None:
+    _assert_invalid_amount("0")
+
+
+def test_ledg_002_ex_004_upper_limit() -> None:
+    assert money.parse_amount("999999.99") == 99_999_999
+    assert money.parse_amount("1000000.00") == 100_000_000
+    _assert_invalid_amount("1000000.01")
+
+
+@pytest.mark.parametrize(("text", "cents"), [("0.01", 1), ("0.02", 2), ("4.1", 410), ("3", 300)])
+def test_ledg_002_valid_amount_in_cents(text: str, cents: int) -> None:
+    assert money.parse_amount(text) == cents
+
+
+@pytest.mark.parametrize("text", ["-0.01", "", "lunch", "1.000", "NaN", "Infinity"])
+def test_ledg_002_invalid_amount(text: str) -> None:
+    _assert_invalid_amount(text)
+
+
+@settings(max_examples=50, derandomize=True)
+@given(cents=st.integers(min_value=1, max_value=100_000_000))
+def test_ledg_002_each_two_decimal_amount_parses_to_whole_cents(cents: int) -> None:
+    euros, remainder = divmod(cents, 100)
+    parsed = money.parse_amount(f"{euros}.{remainder:02d}")
+    assert type(parsed) is int
+    assert parsed == cents
+
+
+@pytest.mark.parametrize(
+    ("cents", "text"), [(0, "0.00"), (1, "0.01"), (410, "4.10"), (300, "3.00")]
+)
+def test_ledg_004_format_amount(cents: int, text: str) -> None:
+    assert money.format_amount(cents) == text
diff --git a/tests/unit/test_store.py b/tests/unit/test_store.py
new file mode 100644
index 0000000000000000000000000000000000000000..d1dc9d6468c1648db71ca37d63e71e8df6e49c68
--- /dev/null
+++ b/tests/unit/test_store.py
@@ -0,0 +1,97 @@
+import json
+from importlib import import_module
+from pathlib import Path
+
+import pytest
+
+store = import_module("src.store")
+
+
+def _entry_fields() -> dict[str, object]:
+    return {
+        "id": "40d60ca3-6e57-48c4-a006-a72d23f69317",
+        "amount_cents": 410,
+        "category": "bus",
+        "note": "",
+        "created": "2026-11-23T10:00:00Z",
+    }
+
+
+def test_ledg_006_missing_file_is_an_empty_ledger(tmp_path: Path) -> None:
+    assert store.load(tmp_path / "missing.json") == []
+
+
+def test_ledg_006_save_writes_the_entry_fields(tmp_path: Path) -> None:
+    path = tmp_path / "new" / "ledger.json"
+    fields = _entry_fields()
+    store.save(path, [store.Entry(**fields)])
+    assert json.loads(path.read_text(encoding="utf-8")) == {"entries": [fields]}
+
+
+def test_ledg_006_load_reads_stored_entries_in_order(tmp_path: Path) -> None:
+    first = _entry_fields()
+    second = first | {"id": "a084e594-0308-40b1-b2b6-9124e73caa70", "note": "return"}
+    path = tmp_path / "ledger.json"
+    path.write_text(json.dumps({"entries": [first, second]}), encoding="utf-8")
+    assert store.load(path) == [store.Entry(**first), store.Entry(**second)]
+
+
+def test_ledg_006_save_replaces_the_previous_file(tmp_path: Path) -> None:
+    path = tmp_path / "ledger.json"
+    old_contents = b'{"entries":[]}'
+    path.write_bytes(old_contents)
+    previous = tmp_path / "previous.json"
+    previous.hardlink_to(path)
+    fields = _entry_fields()
+    store.save(path, [store.Entry(**fields)])
+    assert previous.read_bytes() == old_contents
+    assert json.loads(path.read_text(encoding="utf-8")) == {"entries": [fields]}
+
+
+def _assert_invalid_file(path: Path) -> None:
+    with pytest.raises(ValueError, match=r"^the data file is not a valid ledger\Z"):
+        store.load(path)
+
+
+@pytest.mark.parametrize(
+    "contents",
+    ["not json", "[]", "{}", '{"entries": {}}', '{"entries": [], "extra": 1}', '{"entries": [42]}'],
+)
+def test_ledg_007_invalid_file_raises_value_error(tmp_path: Path, contents: str) -> None:
+    path = tmp_path / "ledger.json"
+    path.write_text(contents, encoding="utf-8")
+    _assert_invalid_file(path)
+
+
+@pytest.mark.parametrize(
+    ("field", "value"),
+    [
+        ("amount_cents", 0),
+        ("amount_cents", 100_000_001),
+        ("amount_cents", True),
+        ("amount_cents", 4.1),
+        ("amount_cents", "410"),
+        ("id", "invalid"),
+        ("id", "40d60ca3-6e57-18c4-a006-a72d23f69317"),
+        ("category", "Bus"),
+        ("category", 12),
+        ("note", None),
+        ("created", "yesterday"),
+        ("created", "2026-11-23T10:00:00"),
+        ("extra", "unexpected"),
+    ],
+)
+def test_ledg_007_invalid_entry_field(tmp_path: Path, field: str, value: object) -> None:
+    fields = _entry_fields() | {field: value}
+    path = tmp_path / "ledger.json"
+    path.write_text(json.dumps({"entries": [fields]}), encoding="utf-8")
+    _assert_invalid_file(path)
+
+
+@pytest.mark.parametrize("field", ["id", "amount_cents", "category", "note", "created"])
+def test_ledg_007_missing_entry_field(tmp_path: Path, field: str) -> None:
+    fields = _entry_fields()
+    del fields[field]
+    path = tmp_path / "ledger.json"
+    path.write_text(json.dumps({"entries": [fields]}), encoding="utf-8")
+    _assert_invalid_file(path)

