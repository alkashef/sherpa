+@pytest.mark.parametrize(("cents", "text"), [(0, "0.00"), (1, "0.01"), (200, "2.00"), (1250, "12.50")])
+def test_ledg_004_format_amount_has_two_decimals(cents: int, text: str) -> None:
+    assert format_amount(cents) == text

