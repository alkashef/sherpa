+        capture_output=True,
+        text=True,
+        check=False,
+    )
+
+
+def _output(result: subprocess.CompletedProcess[str]) -> str:
+    assert result.returncode == 0, result.stderr
+    assert result.stderr == ""
+    return result.stdout
+
+
+def _add(folder: Path, *args: str, data_file: str | None = "ledger.json") -> str:
+    output = _output(_run(folder, "add", *args, data_file=data_file))
+    entry_id = output.removesuffix("\n")
+    assert UUID(entry_id).version == 4
+    assert output == f"{entry_id}\n"
+    return entry_id
+
+
+def _assert_amount_error(result: subprocess.CompletedProcess[str]) -> None:
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr == (
+        "error: the amount must be a number from 0.01 to 1000000.00 with at most two decimals\n"
+    )
+
+
+def test_ledg_001_ex_001_add_prints_the_id_and_stores_the_entry(tmp_path: Path) -> None:
+    entry_id = _add(tmp_path, "12.50", "food", "--note", "lunch")
+    assert _output(_run(tmp_path, "list")) == f"{entry_id}\t12.50\tfood\tlunch\n"
+    data = json.loads((tmp_path / "ledger.json").read_text(encoding="utf-8"))
+    (entry,) = data["entries"]
+    created = entry["created"]
+    assert datetime.fromisoformat(created).utcoffset() == timedelta(0)
+    assert entry == {
+        "id": entry_id,
+        "amount_cents": 1250,
+        "category": "food",
+        "note": "lunch",
+        "created": created,
+    }
+
+
+def test_ledg_001_ex_004_largest_amount_is_stored(tmp_path: Path) -> None:
+    entry_id = _add(tmp_path, "1000000.00", "food")
+    _assert_amount_error(_run(tmp_path, "add", "1000000.01", "food"))
+    assert _output(_run(tmp_path, "list")) == f"{entry_id}\t1000000.00\tfood\t\n"
+
+
+def test_ledg_002_ex_002_cli_refuses_three_decimals(tmp_path: Path) -> None:
+    _add(tmp_path, "1", "bus")
+    path = tmp_path / "ledger.json"
+    original = path.read_bytes()
+    _assert_amount_error(_run(tmp_path, "add", "12.345", "food"))
+    assert path.read_bytes() == original
+
+
+def test_ledg_002_ex_003_cli_refuses_zero(tmp_path: Path) -> None:
+    _assert_amount_error(_run(tmp_path, "add", "0", "food"))
+    assert _output(_run(tmp_path, "list")) == ""
+
+
+@pytest.mark.parametrize("category", ["Food", "", "a" * 21, "café", "a1", "two words"])
+def test_ledg_003_ex_005_uppercase_category_is_refused(tmp_path: Path, category: str) -> None:
+    result = _run(tmp_path, "add", "5", category)
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert result.stderr == "error: the category must be 1 to 20 lowercase letters\n"
+    assert _output(_run(tmp_path, "list")) == ""
+
+
+@settings(max_examples=50, derandomize=True, deadline=None)
+@given(category=st.text(alphabet=ascii_lowercase, min_size=1, max_size=20))
+def test_ledg_003_lowercase_categories_are_stored(category: str) -> None:
+    with TemporaryDirectory() as directory:
+        folder = Path(directory)
+        entry_id = _add(folder, "1", category)
+        assert _output(_run(folder, "list")) == f"{entry_id}\t1.00\t{category}\t\n"
+
+
+@pytest.mark.parametrize("length", [1, 2, 19, 20])
+def test_ledg_003_valid_category_lengths(tmp_path: Path, length: int) -> None:
+    category = "a" * length
+    entry_id = _add(tmp_path, "1", category)
+    assert _output(_run(tmp_path, "list")) == f"{entry_id}\t1.00\t{category}\t\n"
+
+
+def test_ledg_004_ex_006_total_and_total_of_a_category(tmp_path: Path) -> None:
+    _add(tmp_path, "12.50", "food")
+    _add(tmp_path, "7.25", "food")
+    _add(tmp_path, "3", "bus")
+    assert _output(_run(tmp_path, "total")) == "22.75\n"
+    assert _output(_run(tmp_path, "total", "--category", "food")) == "19.75\n"
+    assert _output(_run(tmp_path, "total", "--category", "books")) == "0.00\n"
+
+
+def test_ledg_004_ex_007_empty_total(tmp_path: Path) -> None:
+    assert _output(_run(tmp_path, "total")) == "0.00\n"
+
+
+def test_ledg_005_ex_008_list_in_order_of_entry(tmp_path: Path) -> None:
+    first = _add(tmp_path, "4.10", "bus")
+    second = _add(tmp_path, "2", "food", "--note", "bread")
+    assert first != second
+    assert _output(_run(tmp_path, "list")) == f"{first}\t4.10\tbus\t\n{second}\t2.00\tfood\tbread\n"
+
+
+def test_ledg_006_ex_009_add_makes_the_folder(tmp_path: Path) -> None:
+    _add(tmp_path, "1", "food", data_file="new/ledger.json")
+    assert (tmp_path / "new" / "ledger.json").is_file()
+    assert _output(_run(tmp_path, "total", data_file="new/ledger.json")) == "1.00\n"
+
+
+def test_ledg_006_default_data_file_in_working_folder(tmp_path: Path) -> None:
+    entry_id = _add(tmp_path, "1", "food", data_file=None)
+    path = tmp_path / "data" / "ledger.json"
+    data = json.loads(path.read_text(encoding="utf-8"))
+    assert [entry["id"] for entry in data["entries"]] == [entry_id]
+
+
+@pytest.mark.parametrize("args", [("total",), ("list",), ("add", "1", "food")])
+def test_ledg_007_ex_010_invalid_data_file_exits_3(tmp_path: Path, args: tuple[str, ...]) -> None:
+    path = tmp_path / "ledger.json"
+    path.write_bytes(b"not json")
+    result = _run(tmp_path, *args)
+    assert result.returncode == 3
+    assert result.stdout == ""
+    assert result.stderr == "error: the data file is not a valid ledger\n"
+    assert path.read_bytes() == b"not json"
diff --git a/tests/unit/test_money.py b/tests/unit/test_money.py
new file mode 100644
index 0000000000000000000000000000000000000000..e32cf286212e29183bbc6fa5cee980dd1e0c1810
--- /dev/null
+++ b/tests/unit/test_money.py
@@ -0,0 +1,49 @@
+import pytest
+from hypothesis import given, settings
+from hypothesis import strategies as st
+
+from src.money import format_amount, parse_amount
+
+
+def _assert_invalid_amount(text: str) -> None:
+    message = r"^the amount must be a number from 0\.01 to 1000000\.00 with at most two decimals\Z"
+    with pytest.raises(ValueError, match=message):
+        parse_amount(text)
+
+
+def test_ledg_002_ex_002_three_decimals_are_refused() -> None:
+    _assert_invalid_amount("12.345")
+
+
+def test_ledg_002_ex_003_zero_is_refused() -> None:
+    _assert_invalid_amount("0")
+
+
+def test_ledg_002_ex_004_upper_limit() -> None:
+    assert parse_amount("999999.99") == 99_999_999
+    assert parse_amount("1000000.00") == 100_000_000
+    _assert_invalid_amount("1000000.01")
+
+
+@pytest.mark.parametrize(("text", "cents"), [("0.01", 1), ("0.02", 2), ("4.1", 410), ("2", 200)])
+def test_ledg_002_valid_amount_in_cents(text: str, cents: int) -> None:
+    assert parse_amount(text) == cents
+
+
+@pytest.mark.parametrize("text", ["", "lunch", "-0.01", "NaN", "Infinity", "12.340"])
+def test_ledg_002_invalid_amount_is_refused(text: str) -> None:
+    _assert_invalid_amount(text)
+
+
+@settings(max_examples=50, derandomize=True)
+@given(cents=st.integers(min_value=1, max_value=100_000_000))
+def test_ledg_002_valid_two_decimal_amounts_preserve_cents(cents: int) -> None:
+    euros, remainder = divmod(cents, 100)
+    assert parse_amount(f"{euros}.{remainder:02d}") == cents
+
+
+@pytest.mark.parametrize(
+    ("cents", "text"), [(0, "0.00"), (1, "0.01"), (200, "2.00"), (1250, "12.50")]
+)
+def test_ledg_004_format_amount_has_two_decimals(cents: int, text: str) -> None:
+    assert format_amount(cents) == text
diff --git a/tests/unit/test_store.py b/tests/unit/test_store.py
new file mode 100644
index 0000000000000000000000000000000000000000..a430803981423852daa0318fa069de08d6dc4d25
--- /dev/null
+++ b/tests/unit/test_store.py
@@ -0,0 +1,74 @@
+import json
+from pathlib import Path
+
+import pytest
+
+from src.store import Entry, load, save
+
+
+@pytest.fixture
+def stored_entry() -> dict[str, object]:
+    return {
+        "id": "14870c00-1405-4cea-b22c-a7b1323370db",
+        "amount_cents": 1250,
+        "category": "food",
+        "note": "lunch",
+        "created": "2026-11-23T10:00:00Z",
+    }
+
+
+def _assert_invalid_ledger(path: Path) -> None:
+    with pytest.raises(ValueError, match=r"^the data file is not a valid ledger\Z"):
+        load(path)
+
+
+def test_ledg_006_missing_file_is_an_empty_ledger(tmp_path: Path) -> None:
+    assert load(tmp_path / "missing.json") == []
+
+
+@pytest.mark.parametrize(
+    "content",
+    ["not json", "[]", "{}", '{"entries": {}}', '{"entries": [], "extra": 0}', '{"entries": [{}]}'],
+)
+def test_ledg_007_invalid_file_raises_value_error(tmp_path: Path, content: str) -> None:
+    path = tmp_path / "ledger.json"
+    path.write_text(content, encoding="utf-8")
+    _assert_invalid_ledger(path)
+
+
+@pytest.mark.parametrize(
+    ("field", "value"),
+    [
+        ("id", "invalid"),
+        ("id", "14870c00-1405-1cea-b22c-a7b1323370db"),
+        ("amount_cents", 0),
+        ("amount_cents", 100_000_001),
+        ("amount_cents", "1250"),
+        ("amount_cents", 12.5),
+        ("amount_cents", True),
+        ("category", "Food"),
+        ("category", ""),
+        ("category", "a" * 21),
+        ("note", None),
+        ("created", "yesterday"),
+        ("created", "2026-11-23T10:00:00"),
+        ("extra", ""),
+    ],
+)
+def test_ledg_007_invalid_entry_is_refused(
+    tmp_path: Path, stored_entry: dict[str, object], field: str, value: object
+) -> None:
+    path = tmp_path / "ledger.json"
+    invalid_entry = {**stored_entry, field: value}
+    path.write_text(json.dumps({"entries": [invalid_entry]}), encoding="utf-8")
+    _assert_invalid_ledger(path)
+
+
+def test_ledg_006_save_writes_the_entry(tmp_path: Path, stored_entry: dict[str, object]) -> None:
+    path = tmp_path / "new" / "ledger.json"
+    entry = Entry(
+        "14870c00-1405-4cea-b22c-a7b1323370db", 1250, "food", "lunch", "2026-11-23T10:00:00Z"
+    )
+    save(path, [entry])
+    assert json.loads(path.read_text(encoding="utf-8")) == {"entries": [stored_entry]}
+    assert load(path) == [entry]

