# Coverage configuration. pytest-cov reads it for the 80% branch-coverage floor.
# Never weaken it to make a change pass. Fix the tests.

[run]
# Also measure the Python processes that a test starts, such as an end-to-end test that runs
# main.py to its end. Without it, code that only such a test reaches counts as not covered.
# A process that a test stops, such as a server, writes no data, so test its code in the test
# process too (see Testing in CLAUDE.md).
patch = subprocess
